# PDF Optimizer Configuration Template
# Скопируйте этот файл в .env и заполните значениями для вашего окружения

# === Пути (серверные пути по умолчанию) ===
# Базовая директория для данных
PDF_OPTIMIZER__DATA_DIR=/data

# Директория для логов
PDF_OPTIMIZER__LOG_DIR=/var/log/pdf-optimizer

# Путь к SQLite базе данных реестра
PDF_OPTIMIZER__DB_PATH=/data/registry.sqlite

# === API конфигурация ===
# Хост для прослушивания
PDF_OPTIMIZER__API__HOST=0.0.0.0

# Порт API сервера
PDF_OPTIMIZER__API__PORT=8080

# === Логирование ===
# Уровень логирования: DEBUG, INFO, WARNING, ERROR
PDF_OPTIMIZER__LOG_LEVEL=INFO

# === Настройки резервного копирования ===
# Не создавать резервные копии (true/false)
PDF_OPTIMIZER__NO_BACKUP=false

# Срок хранения резервных копий в днях
PDF_OPTIMIZER__BACKUP_RETENTION_DAYS=30

# === Системные бинарники ===
# Путь к Ghostscript (оставьте 'gs' если в PATH)
PDF_OPTIMIZER__GHOSTSCRIPT_PATH=gs

# Путь к MuPDF mutool (оставьте 'mutool' если в PATH)
PDF_OPTIMIZER__MUTOOL_PATH=mutool

# === Планировщик задач (пример) ===
# Формат: PDF_OPTIMIZER__SCHEDULER__JOBS__0__{field}
# PDF_OPTIMIZER__SCHEDULER__JOBS__0__NAME=hourly_compression
# PDF_OPTIMIZER__SCHEDULER__JOBS__0__CRON=0 * * * *
# PDF_OPTIMIZER__SCHEDULER__JOBS__0__SINCE=24h
# PDF_OPTIMIZER__SCHEDULER__JOBS__0__ROOT_DIR=/data/pdfs
# PDF_OPTIMIZER__SCHEDULER__JOBS__0__QUALITY=default
# PDF_OPTIMIZER__SCHEDULER__JOBS__0__AGGRESSION=gg

# === Rate Limiting (опционально) ===
# Количество запросов в минуту на один IP
PDF_OPTIMIZER__RATE_LIMIT=60
